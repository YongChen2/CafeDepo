# --- Vercel Blob (úložiště obědového menu) ---
# Vytvoří se automaticky po propojení Blob store ve Vercel projektu
# (Storage -> Create Database -> Blob). Lokálně stáhneš přes `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# --- Administrace /admin ---
# Heslo pro přihlášení klientky do administrace obědového menu.
ADMIN_PASSWORD=

# Tajný klíč pro podepisování přihlašovací cookie (min. 32 náhodných znaků).
# Vygeneruj např. příkazem: openssl rand -base64 32
AUTH_SECRET=

# --- Web ---
# Veřejná URL webu (pro sitemap, JSON-LD, Open Graph).
NEXT_PUBLIC_SITE_URL=https://depocafe.cz
